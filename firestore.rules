rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public site content (school info, faculty, activities, achievements,
    // gallery, theme colors) — anyone can read, only logged-in staff can edit.
    match /content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admission applications — anyone can submit (create),
    // but only logged-in staff can read the list or delete entries.
    match /admissions/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
