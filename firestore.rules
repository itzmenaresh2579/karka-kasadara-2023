rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Website content (home/about/contact) — anyone can read, only signed-in staff can edit
    match /content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery photos — anyone can read, only signed-in staff can add/delete
    match /gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
